SerialPort:
    column: "EVE_Components"
    category: "Other"
    prefab:
        blocks:
            -
                color: 3388CC
                position: (7.5, 0, 0.5)
                scale: (16, 2, 2)
        inputs:
            # Inputs 0-7 (y=0.5, back face): TX data bits 0-7, MSB on the left
            # (bit 0 at x=11, bit 7 at x=4), as Eve's RAM's data pegs
            -
                position: (11, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (10, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (9, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (8, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (7, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (6, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (5, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (4, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Input 8 (x=0, y=1.5): WR, rising edge sends the TX byte (or adds it to
            # the command line when CMD is high)
            # Input 9 (x=1): CMD
            # Input 10 (x=2): RD, falling edge consumes the RX byte shown
            -
                position: (0, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (1, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (2, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
        outputs:
            # Outputs 0-7 (y=0.5, front face): RX data bits 0-7, MSB on the left
            -
                position: (11, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (10, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (9, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (8, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (7, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (6, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (5, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (4, 0.5, 1.5)
                rotation: (90, 0, 0)
            # Outputs 8-12 (y=1.5): RXV (x=0) a byte is shown, CONN (x=1) connected,
            # LSN (x=2) listening, TXR (x=3) room to send, ERR (x=4) last command failed
            -
                position: (0, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (1, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (2, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (3, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (4, 1.5, 1.5)
                rotation: (90, 0, 0)
    logicCode: EVE.Components.Server.SerialPortLogic
    placingRules:
        offsetDimensions: (10, 3)
        gridPlacingDimensions: (16, 5)
        allowFineRotation: false
