MicrocodeROM:
    column: "Miscellaneous"
    prefab:
        blocks:
            -
                color: 88CCFF
                position: (16, 0, 0.5)
                scale: (32, 2, 2)
        inputs:
            # Row 1 (y=0.5): Control signals + Address bits, back face
            # Controls on far left, address bits to the right
            # Input 0: Write enable (rising edge writes DWORD at addressed index)
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Input 1: Save trigger (rising edge persists ROM contents to world data)
            -
                position: (1, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Input 2: Restore trigger (rising edge reverts ROM to originally-loaded data)
            -
                position: (2, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Inputs 3-18: Address bits 15-0 (MSB on left, LSB on right)
            # Peg index 3 (bit 15, MSB) at x=3 (leftmost of address range)
            # Peg index 18 (bit 0, LSB) at x=18 (rightmost of address range)
            -
                position: (3, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (4, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (5, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (6, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (7, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (8, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (9, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (10, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (11, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (12, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (13, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (14, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (15, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (16, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (17, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (18, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Row 2 (y=1.5): Write data bits 31-0, back face
            # Peg index 19 (bit 31, MSB) at x=0 (leftmost)
            # Peg index 50 (bit 0, LSB) at x=31 (rightmost)
            -
                position: (0, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (1, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
