NetworkPort:
    column: "EVE_Components"
    category: "Other"
    prefab:
        blocks:
            -
                color: 3388CC
                position: (7.5, 0, 0.5)
                scale: (16, 2, 2)
        inputs:
            # Input n is bit n of the word written (docs/network-port.html).
            # Inputs 0-7 (y=0.5, back face): data bits 0-7, bit 0 at x=11, bit 7 at x=4
            -
                position: (11, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (10, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (9, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (8, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (7, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (6, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (5, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (4, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Inputs 8-15 (y=1.5): control bits 8-15 (8 SEND, 9 CMD, 10 HANGUP, 11-15
            # reserved), bit 8 at x=11, bit 15 at x=4
            -
                position: (11, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (10, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (9, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (8, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (7, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (6, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (5, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (4, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            # Input 16 (x=0, y=1.5): WR, rising edge samples inputs 0-15
            # Input 17 (x=1): RD_DATA, high then low: the byte shown was read
            # Input 18 (x=2): RD_STATUS, high then low: HUP and ECODE were seen
            -
                position: (0, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (1, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
            -
                position: (2, 1.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.6
        outputs:
            # Output n is bit n of the word read.
            # Outputs 0-7 (y=0.5, front face): the received byte, bit 0 at x=11
            -
                position: (11, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (10, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (9, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (8, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (7, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (6, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (5, 0.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (4, 0.5, 1.5)
                rotation: (90, 0, 0)
            # Outputs 8-15 (y=1.5): 8 READY, 9 CONN, 10 LSN, 11 ROOM, 12 HUP,
            # 13-15 ECODE; bit 8 at x=11, bit 15 at x=4
            -
                position: (11, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (10, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (9, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (8, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (7, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (6, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (5, 1.5, 1.5)
                rotation: (90, 0, 0)
            -
                position: (4, 1.5, 1.5)
                rotation: (90, 0, 0)
    logicCode: EVE.Components.Server.NetworkPortLogic
    placingRules:
        offsetDimensions: (10, 3)
        gridPlacingDimensions: (16, 5)
        allowFineRotation: false
