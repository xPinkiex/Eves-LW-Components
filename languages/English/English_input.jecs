EVE_Components.Placeholder: """
    Paste bytes here...
    
    0x01 0b11001000 0xFF
    @0x0100
    0x42 0b00000001
    
    Lines starting with // are ignored.
    Use 0x for hex, 0b for binary.
    Use @0xADDR to set current address.
    """
